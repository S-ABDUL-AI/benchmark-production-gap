# .env.example
# Copy this file to .env and fill in your credentials.
# Never commit .env to GitHub — it is listed in .gitignore.

# ── Anthropic (Claude classifier) ─────────────────────────
# Get your key at: console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# ── OpenAI (GPT-4 classifier — optional) ──────────────────
# Get your key at: platform.openai.com
OPENAI_API_KEY=sk-...

# ── HuggingFace (LMSYS-Chat-1M download) ──────────────────
# Get your token at: huggingface.co/settings/tokens
# Required — LMSYS-Chat-1M is gated (requires account + agreement)
HF_TOKEN=hf_...

# ── Paths (optional overrides) ────────────────────────────
# Where to cache downloaded datasets (default: ~/.cache/huggingface)
HF_DATASETS_CACHE=./data/cache

# Where to save analysis outputs
OUTPUT_DIR=./outputs
